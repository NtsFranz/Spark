  <!--
    The Svelte overlay site (/overlays/, /components/minimap/, ...) is served from Overlay\build.
    Build it automatically when it is missing so the app never ships without it.
    Pass -p:SkipOverlayBuild=true to opt out (e.g. machines without Node.js).
  -->
  <ItemGroup>
    <SvelteOverlaySource Include="Overlay\src\**\*;Overlay\static\**\*;Overlay\svelte.config.js;Overlay\vite.config.ts;Overlay\package.json" />
  </ItemGroup>
  <!-- Rebuilds the overlay site whenever its sources change. -->
  <Target Name="BuildSvelteOverlays" BeforeTargets="AssignTargetPaths" Condition="'$(SkipOverlayBuild)' != 'true'"
          Inputs="@(SvelteOverlaySource)" Outputs="$(MSBuildProjectDirectory)\Overlay\build\.build_stamp">
    <Exec Command="npm install --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)\Overlay" Condition="!Exists('$(MSBuildProjectDirectory)\Overlay\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\Overlay" />
    <Touch Files="$(MSBuildProjectDirectory)\Overlay\build\.build_stamp" AlwaysCreate="true" />
  </Target>
  <Target Name="IncludeSvelteOverlays" AfterTargets="BuildSvelteOverlays" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <!-- globbed inside a target (not at evaluation time) so a build produced just above is included -->
      <Content Include="Overlay\build\**\*" Exclude="@(Content);Overlay\build\.build_stamp">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
  </Target>
