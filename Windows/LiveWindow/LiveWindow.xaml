                            BorderBrush="{DynamicResource SurfaceBorder}"/>
                </StackPanel>

                <StackPanel>

                <StackPanel x:Name="casterToolsBox" Visibility="Visible">
                    <TextBlock Text="CASTER TOOLS" Style="{StaticResource SidebarHeading}"/>
                    <Button Content="{x:Static p:Resources.Restart_as_Spectator}" Style="{StaticResource ToolButton}"
                            Click="RestartAsSpectatorClick" ToolTip="{x:Static p:Resources.Restarts_the_game_in_the_2D_spectator_mode_}"/>
                    <Button Content="{x:Static p:Resources.Find_All_Quests}" Style="{StaticResource ToolButton}"
                            Click="FindAllQuests" ToolTip="{x:Static p:Resources.Shows_a_list_of_all_the_Quest_IPs_on_the_network_}"/>
                    <Button x:Name="PasteLinkInLiveButton" Content="{x:Static p:Resources.Paste_link_in__live}"
                            Style="{StaticResource ToolButton}" Click="PasteLinkInLive"/>
                    <Button x:Name="LeagueOverlaysButton" Content="{x:Static p:Resources.League_Overlays}"
                            Style="{StaticResource ToolButton}" Click="LeagueOverlaysClick"/>
                    <Button x:Name="MatchSetupButton" Content="{x:Static p:Resources.Match_Setup_Page}"
                            Style="{StaticResource ToolButton}" Click="MatchSetupClick"/>
                </StackPanel>

                <TextBlock Text="TOOLS" Style="{StaticResource SidebarHeading}" Margin="0,12,0,7"/>

                <Button x:Name="updateButton" Content="{x:Static p:Resources.Download_Update}" Style="{StaticResource ToolButton}"
                        HorizontalContentAlignment="Center" Background="#FF8B3434" Click="updateButton_Click"
                        ToolTip="{x:Static p:Resources.Downloads_and_installs_the_most_recent_update__recommended_}" Visibility="Collapsed"/>
                <ProgressBar x:Name="updateProgressBar" Height="4" Visibility="Collapsed" Margin="0,0,0,5"/>
                <Button x:Name="enableAPIButton" Content="{x:Static p:Resources.Enable_API_in_Settings}"
                        Style="{StaticResource ToolButton}" HorizontalContentAlignment="Center"
                        Visibility="Collapsed" Click="enableAPIButton_Click"/>

                <Button x:Name="startSpectatorStream" Style="{StaticResource ToolButton}" Click="StartSpectatorStreamClick"
                        ToolTip="{x:Static p:Resources.Spectatorstream_tooltip}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Style="{StaticResource ToolIcon}" Data="M1,3 H15 V13 H1 Z M6.5,6 L11,8 L6.5,10 Z"/>
                        <TextBlock Grid.Column="1" Text="Spectator stream" Margin="9,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Button>

                <Button x:Name="chooseServerRegion" Style="{StaticResource ToolButton}" Click="chooseServerRegion_Click"
                        ToolTip="{x:Static p:Resources.This_creates_a_private_match_in_a_region_of_your_choice_}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Style="{StaticResource ToolIcon}"
                              Data="M8,1.5 A6.5,6.5 0 1,1 7.99,1.5 M1.5,8 H14.5 M8,1.5 C10.8,4 10.8,12 8,14.5 C5.2,12 5.2,4 8,1.5 Z"/>
                        <TextBlock Grid.Column="1" Text="Server region" Margin="9,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Button>

                <Button x:Name="playspaceButton" Content="{x:Static p:Resources.Show_Playspace}" Style="{StaticResource ToolButton}"
                        Click="playspaceButton_Click" Visibility="Collapsed"/>

                <Button x:Name="loneEchoSubtitlesButton" Style="{StaticResource ToolButton}" Click="LoneEchoSubtitlesClick">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Style="{StaticResource ToolIcon}" Data="M1,3.5 H15 V12.5 H1 Z M4,9.5 H7 M9,9.5 H12"/>
                        <TextBlock Grid.Column="1" Text="Lone Echo subs" Margin="9,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Button>

                <Button Style="{StaticResource ToolButton}" Click="ACIIECHO_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ToolIcon}" Data="M1,13 L8,3 L15,13 Z"/>
                        <TextBlock Text="ASCIIECHO" Margin="9,0,0,0" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas"/>
                    </StackPanel>
                </Button>

                <DockPanel>
                    <Button DockPanel.Dock="Right" Width="34" Content="VR" Style="{StaticResource ToolButton}"
                            Margin="5,0,0,5" Padding="0" HorizontalContentAlignment="Center" FontSize="10.5"
                            Click="ReplayViewerVR_Click"/>
                    <Button Style="{StaticResource ToolButton}" Click="ReplayViewer_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ToolIcon}" Data="M14,8 A6,6 0 1,1 12.2,3.8 M14,1.5 V5.4 H10.1"/>
                            <TextBlock Text="Replay viewer" Margin="9,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                </DockPanel>
                <ProgressBar x:Name="ReplayViewerProgressBar" Height="4" Visibility="Collapsed" Margin="0,0,0,5" IsIndeterminate="True"/>

                <Button x:Name="SpeedometerButton" Content="{x:Static p:Resources.Speedometer}" Style="{StaticResource ToolButton}"
                        Click="OpenSpeedometer" Visibility="Collapsed"/>

                <DockPanel>
                    <Button DockPanel.Dock="Right" Width="30" Style="{StaticResource ToolButton}" Margin="5,0,0,5"
                            Padding="0" HorizontalContentAlignment="Center" Click="DefaultMatchSetupClick">
                        <Path Style="{StaticResource ToolIcon}" Data="M8,5.8 A2.2,2.2 0 1,1 7.99,5.8 M8,1.5 V3.5 M8,12.5 V14.5 M1.5,8 H3.5 M12.5,8 H14.5 M3.4,3.4 L4.8,4.8 M11.2,11.2 L12.6,12.6 M12.6,3.4 L11.2,4.8 M4.8,11.2 L3.4,12.6"/>
                    </Button>
                    <Button x:Name="OverlaysButton" Style="{StaticResource ToolButton}" Click="OpenOverlays">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ToolIcon}" Data="M1,2.5 H15 V13.5 H1 Z M1,6 H15"/>
                            <TextBlock Text="{x:Static p:Resources.Overlays}" Margin="9,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Button>
                </DockPanel>

                <Button x:Name="showHighlights" Content="{x:Static p:Resources.NVIDIAHighlights}"
                        Style="{StaticResource ToolButton}" Click="showHighlights_Click"/>

                <Button x:Name="spectateMeButton" Style="{StaticResource ToolButton}" Height="34" Click="SpectateMeClicked"
                        ToolTip="Spectate Me launches the PC version of Echo VR in spectator mode into your Quest match. Spectate Me is not necessary for Spark to work.">
                    <DockPanel LastChildFill="True">
                        <Path DockPanel.Dock="Left" Style="{StaticResource ToolIcon}" Data="M8,3.5 A4.5,4.5 0 1,1 7.99,3.5 M8,6.4 A1.6,1.6 0 1,1 7.99,6.4"/>
                        <TextBlock x:Name="spectateMeSubtitle" DockPanel.Dock="Right" Text="{x:Static p:Resources.Not_active}"
                                   FontSize="9.5" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFaint}"/>
                        <Label x:Name="spectateMeLabel" Content="{x:Static p:Resources.Spectate_Me}"
                               Padding="9,0,0,0" FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>

                <TextBlock Text="SESSION" Style="{StaticResource SidebarHeading}" Margin="0,12,0,7"/>
                <Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="10,9,10,9">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,7">
                            <TextBlock DockPanel.Dock="Left" Text="Goals" FontSize="11.5" Foreground="{DynamicResource TextDim}"/>
                            <TextBlock x:Name="SessionGoalsLabel" DockPanel.Dock="Right" Text="0" FontSize="12.5"
                                       FontWeight="SemiBold" FontFamily="Consolas" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,7">
                            <TextBlock DockPanel.Dock="Left" Text="Saves" FontSize="11.5" Foreground="{DynamicResource TextDim}"/>
                            <TextBlock x:Name="SessionSavesLabel" DockPanel.Dock="Right" Text="0" FontSize="12.5"
                                       FontWeight="SemiBold" FontFamily="Consolas" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,7">
                            <TextBlock DockPanel.Dock="Left" Text="Fastest disc" FontSize="11.5" Foreground="{DynamicResource TextDim}"/>
                            <TextBlock x:Name="SessionFastestDiscLabel" DockPanel.Dock="Right" Text="--" FontSize="12.5"
                                       FontWeight="SemiBold" FontFamily="Consolas" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="Playtime" FontSize="11.5" Foreground="{DynamicResource TextDim}"/>
                            <TextBlock x:Name="SessionPlaytimeLabel" DockPanel.Dock="Right" Text="0m" FontSize="12.5"
                                       FontWeight="SemiBold" FontFamily="Consolas" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="10,9,10,9" Margin="0,7,0,0">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="All-Time Playtime" FontSize="11.5" Foreground="{DynamicResource TextDim}"/>
                            <TextBlock x:Name="AllTimePlaytimeLabel" DockPanel.Dock="Right" Text="0h" FontSize="12.5"
                                       FontWeight="SemiBold" FontFamily="Consolas" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </DockPanel>
                        <DockPanel Margin="0,7,0,0"
                                   ToolTip="Total playtime across everyone running Spark. Contribute yours from Settings.">
                            <TextBlock DockPanel.Dock="Left" Text="Everyone on Spark" FontSize="11.5" Foreground="{DynamicResource TextDim}"/>
                            <TextBlock x:Name="GlobalPlaytimeLabel" DockPanel.Dock="Right" Text="--" FontSize="12.5"
                                       FontWeight="SemiBold" FontFamily="Consolas" HorizontalAlignment="Right"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </DockPanel>
                    </StackPanel>
                </Border>

                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ══════════════ FOOTER ══════════════ -->
        <Border Grid.Row="2" Grid.ColumnSpan="5" Background="{DynamicResource SurfaceChrome}"
                BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="0,1,0,0">
            <DockPanel Margin="14,0,10,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="5" Height="5" VerticalAlignment="Center" Fill="{DynamicResource StatusGood}"/>
                    <TextBlock x:Name="accessCodeLabel" Text="{x:Static p:Resources.Mode}" FontSize="11" Margin="7,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextDim}"/>
                    <ComboBox x:Name="AccessCodesComboboxLiveWindow" Height="22" MinWidth="96" Margin="7,0,0,0" FontSize="11"
                              VerticalAlignment="Center" SelectedIndex="0" SelectionChanged="AccessCodeChangedLiveWindow"/>
                    <Border Width="1" Height="12" Margin="12,0,12,0" VerticalAlignment="Center"
                            Background="{DynamicResource SurfaceBorder}"/>
                    <TextBlock x:Name="versionLabel" Text="{Binding AppVersionLabelText}" FontSize="11" FontFamily="Consolas"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextFaint}"/>
                    <Border x:Name="UpdateAvailableBadge" Visibility="Collapsed" Margin="10,0,0,0" CornerRadius="9"
                            Padding="8,2,8,2" Background="{DynamicResource StatusGoodTint}"
                            BorderBrush="{DynamicResource StatusGoodEdge}" BorderThickness="1" Cursor="Hand"
                            MouseLeftButtonUp="UpdateAvailableBadgeClicked" ToolTip="Click to view and install">
                        <TextBlock Text="Update available" FontSize="10.5" FontWeight="SemiBold"
                                   Foreground="{DynamicResource StatusGood}"/>
                    </Border>
                    <ProgressBar x:Name="DownloadingOverlaysBar" Visibility="Collapsed" IsIndeterminate="True"
                                 Width="90" Height="4" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DownloadingOverlaysText" Text="Downloading overlays..." Visibility="Collapsed"
                               FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFaint}"/>
                </StackPanel>

                <StackPanel Height="48" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="rejoinButton" Content="{x:Static p:Resources.Rejoin}" Width="96" Height="26" Margin="0,0,6,0"
                            FontSize="11.5" Background="#FF6E2F2F" BorderBrush="#FF6E2F2F" Click="RejoinClicked"
                            ToolTip="{x:Static p:Resources.rejoin_tooltip}" Visibility="Collapsed"/>
                    <Button x:Name="settingsButton" Height="26" Margin="0,0,6,0" Padding="11,0,11,0" FontSize="11.5"
                            Click="SettingsButtonClicked" ToolTip="{x:Static p:Resources.settings_button_tooltip}"
                            Background="{DynamicResource ControlDefaultBackground}"
                            Foreground="{DynamicResource ControlPrimaryForeground}"
                            BorderBrush="{DynamicResource SurfaceBorder}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.3" VerticalAlignment="Center"
                                  Stroke="{DynamicResource ControlPrimaryForeground}"
                                  Data="M8,5.8 A2.2,2.2 0 1,1 7.99,5.8 M8,1.5 V3.5 M8,12.5 V14.5 M1.5,8 H3.5 M12.5,8 H14.5 M3.4,3.4 L4.8,4.8 M11.2,11.2 L12.6,12.6 M12.6,3.4 L11.2,4.8 M4.8,11.2 L3.4,12.6"/>
                            <TextBlock Text="{x:Static p:Resources.Settings}" Margin="7,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="hideButton" Content="{x:Static p:Resources.Hide}" Height="26" Width="66" Margin="0,0,6,0"
                            FontSize="11.5" Click="CloseButtonClicked" ToolTip="{x:Static p:Resources.hide_tooltip}"
                            Background="{DynamicResource ControlDefaultBackground}"
                            Foreground="{DynamicResource ControlPrimaryForeground}"
                            BorderBrush="{DynamicResource SurfaceBorder}"/>
                    <Button x:Name="exitButton" Content="{x:Static p:Resources.Exit}" Height="26" Width="66" Margin="0"
                            FontSize="11.5" Click="QuitButtonClicked" ToolTip="{x:Static p:Resources.close_tooltip}"
                            Background="{DynamicResource StatusBadTint}"
                            Foreground="{DynamicResource StatusBad}"
                            BorderBrush="{DynamicResource StatusBadEdge}"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <tb:TaskbarIcon x:Name="trayIcon"
            IconSource="/img/ignite_logo.ico"
            ToolTipText="{x:Static p:Resources.AppName}" PopupActivation="DoubleClick" Grid.Column="12" Grid.Row="1">

            <!-- Set a simple context menu  -->
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="showHideMenuItem" Header="{x:Static p:Resources.Hide_Main_Window}" Padding="5,5,5,5" Margin="1,1,1,1" Click="ToggleHidden" />
                    <Separator></Separator>
                    <MenuItem Header="{x:Static p:Resources.Exit}" Padding="5,5,5,5" Margin="1,1,1,1" Click="QuitButtonClicked" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>

        </tb:TaskbarIcon>
    </Grid>
</Window>
