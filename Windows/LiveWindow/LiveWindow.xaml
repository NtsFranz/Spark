            <DockPanel Margin="12,12,12,12">

                <!-- Docked panels are stretched to the full rail width by the DockPanel, but a
                     StackPanel doesn't center its own children in that leftover space — it just
                     packs them at the start, which is why the pair sat pinned to the left with a
                     block of empty rail after Discord. HorizontalAlignment centers the whole row. -->
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0"
                            HorizontalAlignment="Center">
                    <!-- Padding is asymmetric (2px extra on the bottom) rather than the usual "4,2":
                         pixel-measured against the actual render (Wiki button interior y=641..664,
                         text ink y=650..659 at the previous "4,4,4,2" setting put ink 2px *below*
                         true center) — this is the opposite asymmetry, verified the same way. -->
                    <Button Width="82" Height="26" Margin="0,0,5,0" Padding="4,2,4,4" HorizontalContentAlignment="Center"
                            Content="{x:Static p:Resources.Wiki}" Click="OpenWikiClick"
                            Background="{DynamicResource ControlDefaultBackground}"
                            Foreground="{DynamicResource ControlPrimaryForeground}"
                            BorderBrush="{DynamicResource SurfaceBorder}"/>
                    <Button Width="81" Height="26" Margin="0" Padding="4,2,4,4" HorizontalContentAlignment="Center"
                            Content="{x:Static p:Resources.Discord}" Click="OpenDiscordClick"
                            Background="{DynamicResource ControlDefaultBackground}"
