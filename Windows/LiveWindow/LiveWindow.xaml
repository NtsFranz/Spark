<Window x:Class="Spark.LiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:l="clr-namespace:Spark"
        xmlns:p="clr-namespace:Spark.Properties"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Spark" 
        Height="720" Width="1280" 
        FontSize="14" 
        Background="{DynamicResource ControlDarkerBackground}" 
        ResizeMode="CanResize" 
        Name="liveWindow"
        Closed="liveWindow_FormClosed"
        MinHeight="400" MinWidth="900"
        Initialized="LiveWindow_Load"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Top="{l:SettingBinding liveWindowTop}"
        Left="{l:SettingBinding liveWindowLeft}"
        Icon="/img/ignite_logo.ico"
        Opacity="0">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Uniform sidebar button: one height, one padding, icon then label. The old sidebar mixed
             35/40 px heights and widths of 25/36/40/137/141/153, which is what made it look ragged. -->
        <!-- Flat fill, no border, real rounded corners. The theme's default Button template hardcodes
             CornerRadius="4" inside its own ControlTemplate (not TemplateBinding), so a Style setter
             can't reach it — this button gets its own minimal template instead, at CornerRadius 8 to
             match the reference. -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
            <Setter Property="Foreground" Value="{DynamicResource ControlPrimaryForeground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SurfaceRaised}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ControlMouseOverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceBorder}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolIcon" TargetType="Path">
            <Setter Property="Width" Value="14"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="StrokeThickness" Value="1.3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Stroke" Value="{DynamicResource TextDim}"/>
        </Style>

        <!-- The theme's TabPanel wraps onto extra rows once the tabs stop fitting. With several
             optional tabs enabled that means a second row of navigation; this keeps them on one
             line and shrinks them to fit instead. Remove Template="{StaticResource ScrollingTabs}" from the
             TabControl to go back to wrapping. -->
        <Style x:Key="TabStripIconButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ControlMouseOverBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Label used inside a tab header: dim at rest, bright when its TabItem is selected. The
             theme's default Label style hardcodes Foreground (breaking inheritance from the TabItem),
             so this needs its own trigger rather than relying on the selected TabItem's Foreground
             to flow down. Explicit x:Key, applied only to the 16 header labels below — never used
             as an implicit style, so it can't bleed into unrelated Labels elsewhere in the app. -->
        <Style x:Key="TabHeaderLabel" TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TabItem}}, Path=IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate x:Key="ScrollingTabs" TargetType="{x:Type TabControl}">
            <Grid ClipToBounds="True" SnapsToDevicePixels="True" KeyboardNavigation.TabNavigation="Local">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- When the tabs don't fit, shrink them (text and icons) to the available width
                         instead of showing a scrollbar. DownOnly: never scaled up past normal size. -->
                    <Viewbox Grid.Column="0" Panel.ZIndex="1" Stretch="Uniform" StretchDirection="DownOnly"
                             HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel x:Name="headerPanel" Orientation="Horizontal" IsItemsHost="True"
                                    Margin="2,2,2,0" KeyboardNavigation.TabIndex="1"/>
                    </Viewbox>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="6,2,6,0" VerticalAlignment="Center">
                        <Button Style="{StaticResource TabStripIconButton}" Click="RefreshDashboardClick"
                                ToolTip="Reload the dashboard view">
                            <Path Style="{StaticResource ToolIcon}" Width="13" Height="13"
                                  Data="M13.5,8 A5.5,5.5 0 1 1 11.9,4.1 M13.5,2 V5.4 H10.1"/>
                        </Button>
                        <Button Style="{StaticResource TabStripIconButton}" Click="OpenThemeSettingsClick"
                                ToolTip="Change theme">
                            <Path Style="{StaticResource ToolIcon}" Width="13" Height="13"
                                  Data="M8,5.8 A2.2,2.2 0 1 1 7.99,5.8 M8,1.5 V3.5 M8,12.5 V14.5 M1.5,8 H3.5 M12.5,8 H14.5 M3.4,3.4 L4.8,4.8 M11.2,11.2 L12.6,12.6 M12.6,3.4 L11.2,4.8 M4.8,11.2 L3.4,12.6"/>
                        </Button>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        KeyboardNavigation.DirectionalNavigation="Contained"
                        KeyboardNavigation.TabIndex="2" KeyboardNavigation.TabNavigation="Local">
                    <ContentPresenter ContentSource="SelectedContent" Margin="{TemplateBinding Padding}"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                </Border>
            </Grid>
        </ControlTemplate>

        <Style x:Key="SidebarHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="2,0,0,10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
        </Style>
    </Window.Resources>
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{StaticResource FluidDuration}"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="4"/>
            <ColumnDefinition Width="212"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════ HEADER ══════════════ -->
        <Border Grid.Row="0" Grid.ColumnSpan="5" Background="{DynamicResource SurfaceChrome}"
                BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- brand + connection status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="17" Height="17" Stretch="Uniform" Fill="{DynamicResource ControlAccent}"
                          Data="M8.6,1.4 L3.2,9.1 L6.8,9.1 L5.4,14.6 L10.8,6.9 L7.2,6.9 Z"/>
                    <TextBlock Text="Spark" FontSize="14" FontWeight="SemiBold" Margin="9,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimary}"/>
                    <Border Margin="14,0,0,0" Height="24" CornerRadius="12" Padding="8,0,10,0"
                            Background="{DynamicResource SurfaceRaised}"
                            BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="statusCircle" Width="6" Height="6" Fill="Red" VerticalAlignment="Center"/>
                            <Label x:Name="statusLabel" Content="{x:Static p:Resources.Not_Connected}"
                                   FontSize="11.5" Padding="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="NotConnectedHelp" Margin="6,0,0,0" FontSize="11.5" VerticalAlignment="Center">
                                <Hyperlink NavigateUri="https://echopedia.gg/wiki/Spark#Spark_says_Not_Connected_in_the_top_left_corner"
                                           RequestNavigate="Hyperlink_RequestNavigate">
                                    <Run Text="Help" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- score strip -->
                <Border Grid.Column="2" Height="36" VerticalAlignment="Center" CornerRadius="6" ClipToBounds="True"
                        BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28"/>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="54"/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource TeamOrangeTint}">
                            <TextBlock Text="ORN" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TeamOrange}">
                                <TextBlock.LayoutTransform><RotateTransform Angle="-90"/></TextBlock.LayoutTransform>
                            </TextBlock>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource TeamOrange}">
                            <TextBlock x:Name="OrangePoints" Text="0" FontSize="21" FontWeight="Bold" FontFamily="Consolas"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TeamOrangeForeground}"/>
                        </Border>
                        <Border Grid.Column="2" Background="{DynamicResource SurfaceRaised}">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="GameClock" Text="00:00" FontSize="16" FontWeight="SemiBold"
                                           FontFamily="Consolas" TextAlignment="Center"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="RoundStatusLabel" Text="" FontSize="9" FontWeight="SemiBold"
                                           TextAlignment="Center" Margin="0,1,0,0"
                                           Foreground="{DynamicResource TextFaint}"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="3" Background="{DynamicResource TeamBlue}">
                            <TextBlock x:Name="BluePoints" Text="0" FontSize="21" FontWeight="Bold" FontFamily="Consolas"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TeamBlueForeground}"/>
                        </Border>
                        <Border Grid.Column="4" Background="{DynamicResource TeamBlueTint}">
                            <TextBlock Text="BLU" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TeamBlue}">
                                <TextBlock.LayoutTransform><RotateTransform Angle="-90"/></TextBlock.LayoutTransform>
                            </TextBlock>
                        </Border>
                    </Grid>
                </Border>

                <!-- server location + account -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="ServerLocationButtonClicked" Height="28" Padding="10,0,10,0" MaxWidth="200"
                            HorizontalContentAlignment="Left"
                            Background="{DynamicResource ControlDefaultBackground}"
                            Foreground="{DynamicResource ControlPrimaryForeground}"
                            BorderBrush="{DynamicResource SurfaceBorder}">
                        <Label x:Name="serverLocationLabel" Content="{x:Static p:Resources.Server_IP_}"
                               ToolTip="{x:Static p:Resources.server_location_tooltip}" Padding="0" FontSize="11.5"
                               Foreground="{DynamicResource ControlPrimaryForeground}"/>
                    </Button>
                    <Button x:Name="loginButton" Click="LoginWindowButtonClicked" Height="28" Margin="6,0,0,0"
                            Padding="4,0,10,0" HorizontalContentAlignment="Left"
                            ToolTip="{x:Static p:Resources.login_button_tooltip}"
                            Background="{DynamicResource ControlDefaultBackground}"
                            Foreground="{DynamicResource ControlPrimaryForeground}"
                            BorderBrush="{DynamicResource SurfaceBorder}">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="discordPFPImage" Height="20" Width="20" Margin="0,0,7,0" Visibility="Collapsed" />
                            <TextBlock x:Name="discordUsernameLabel" Text="{x:Static p:Resources.Discord_Login}"
                                       VerticalAlignment="Center" FontSize="11.5" MaxWidth="130"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════ LEFT RAIL ══════════════ -->
        <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource SurfaceChrome}"
                BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,12,12,12">

                <Button x:Name="ShowClickableOverlayButton" DockPanel.Dock="Bottom" Style="{StaticResource ToolButton}"
                        Height="32" Margin="0,10,0,0" Click="showOverlay_Click">
                    <DockPanel LastChildFill="True">
                        <Path DockPanel.Dock="Left" Style="{StaticResource ToolIcon}"
                              Data="M1.5,3 H14.5 V12 H1.5 Z M5.5,14.5 H10.5"/>
                        <TextBlock x:Name="ClickableOverlaySubtitle" DockPanel.Dock="Right"
                                   Text="{x:Static p:Resources.Not_active}" FontSize="9.5" FontWeight="SemiBold"
                                   Margin="6,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFaint}"/>
                        <Label x:Name="ClickableOverlayLabel" Content="Spectator overlay" Padding="9,0,0,0"
                               FontSize="12" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>

                <!-- which overlay the toggle shows: a built-in one, a file from the Overlays folder, or any typed URL -->
                <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button DockPanel.Dock="Right" Content="…" Width="26" Height="24" Margin="4,0,0,0" Padding="0"
                            ToolTip="Open the folder for your own overlays (.html files there show up in this list)"
                            Click="OpenOverlayFolder_Click"/>
                    <ComboBox x:Name="OverlayPicker" Height="24" FontSize="11" IsEditable="True"
                              ToolTip="Overlay shown by the Spectator overlay toggle. Pick one, or type any URL and press Enter."
                              SelectionChanged="OverlayPicker_SelectionChanged"
                              KeyDown="OverlayPicker_KeyDown" LostKeyboardFocus="OverlayPicker_LostFocus"
                              DropDownOpened="OverlayPicker_DropDownOpened"/>
                </DockPanel>

                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- join link -->
                <Border Grid.Row="0" Background="{DynamicResource SurfaceRaised}" BorderBrush="{DynamicResource SurfaceBorder}"
                        BorderThickness="1" CornerRadius="6" Padding="10,9,10,9">
                    <StackPanel>
                        <DockPanel LastChildFill="False" Margin="0,0,0,6">
                            <Label x:Name="sessionIdLabel" Content="{x:Static p:Resources.Join_Link_}"
                                   DockPanel.Dock="Left" Padding="0" FontSize="9.5" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextFaint}"/>
                            <Button x:Name="copySessionIdButton" Content="{x:Static p:Resources.Copy}"
                                    DockPanel.Dock="Right" Height="20" Padding="8,0,8,0" FontSize="10.5"
                                    Click="CopyIgniteJoinLink" ToolTip="{x:Static p:Resources.copy_link_tooltip}"
                                    Background="{DynamicResource ControlDefaultBackground}"
                                    Foreground="{DynamicResource ControlPrimaryForeground}"
                                    BorderBrush="{DynamicResource SurfaceBorder}"/>
                        </DockPanel>
                        <TextBox x:Name="sessionIdTextBox" Text="********-****-****-****-************"
                                 TextWrapping="NoWrap" MaxLines="1" FontSize="11" FontFamily="Consolas"
                                 IsReadOnly="True" BorderThickness="0" Padding="0"
                                 ToolTip="{x:Static p:Resources.join_link_tooltip}"
                                 Background="Transparent" Foreground="{DynamicResource ControlAccent}"/>
                    </StackPanel>
                </Border>

                <!-- blue team -->
                <Border x:Name="blueTeamBox" Grid.Row="1" Margin="0,10,0,0" CornerRadius="6" ClipToBounds="True"
                        BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1">
                    <StackPanel>
                        <Border Background="{DynamicResource TeamBlueTint}" Padding="10,7,10,7"
                                BorderBrush="{DynamicResource TeamBlueEdge}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <DockPanel>
                                    <Rectangle DockPanel.Dock="Left" Width="3" Height="12" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource TeamBlue}" VerticalAlignment="Center"/>
                                    <Image x:Name="blueTeamLogo" DockPanel.Dock="Left" Height="16" Width="16" Margin="8,0,0,0"/>
                                    <TextBlock x:Name="BlueTeamCount" DockPanel.Dock="Right" Text="0" FontSize="11"
                                               FontFamily="Consolas" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TeamBlueEdge}"/>
                                    <TextBlock Text="BLUE" FontSize="9.5" FontWeight="SemiBold" Margin="8,0,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TeamBlue}"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="BlueTeamPause" Height="20" FontSize="10.5" Visibility="Collapsed"
                                            Padding="7,0,7,0" Margin="0,5,4,0" Click="BlueTeamPauseClick"
                                            Background="{DynamicResource TeamBlueEdge}"
                                            BorderBrush="{DynamicResource TeamBlueEdge}">Pause</Button>
                                    <Button x:Name="BlueTeamReadyUp" Height="20" FontSize="10.5" Visibility="Collapsed"
                                            Padding="7,0,7,0" Margin="0,5,4,0" Click="BlueTeamReadyClick"
                                            Background="{DynamicResource TeamBlueEdge}"
                                            BorderBrush="{DynamicResource TeamBlueEdge}">Ready</Button>
                                    <Button x:Name="BlueTeamRestart" Height="20" FontSize="10.5" Visibility="Collapsed"
                                            Padding="7,0,7,0" Margin="0,5,0,0" Click="BlueTeamRestartClick"
                                            Background="{DynamicResource TeamBlueEdge}"
                                            BorderBrush="{DynamicResource TeamBlueEdge}">Restart</Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="BlueTeamPlayersBox" Background="{DynamicResource SurfaceCard}">
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- orange team -->
                <Border x:Name="orangeTeamBox" Grid.Row="2" Margin="0,10,0,0" CornerRadius="6" ClipToBounds="True"
                        BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1">
                    <StackPanel>
                        <Border Background="{DynamicResource TeamOrangeTint}" Padding="10,7,10,7"
                                BorderBrush="{DynamicResource TeamOrangeEdge}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <DockPanel>
                                    <Rectangle DockPanel.Dock="Left" Width="3" Height="12" RadiusX="2" RadiusY="2"
                                               Fill="{DynamicResource TeamOrange}" VerticalAlignment="Center"/>
                                    <Image x:Name="orangeTeamLogo" DockPanel.Dock="Left" Height="16" Width="16" Margin="8,0,0,0"/>
                                    <TextBlock x:Name="OrangeTeamCount" DockPanel.Dock="Right" Text="0" FontSize="11"
                                               FontFamily="Consolas" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TeamOrangeEdge}"/>
                                    <TextBlock Text="ORANGE" FontSize="9.5" FontWeight="SemiBold" Margin="8,0,0,0"
                                               VerticalAlignment="Center" Foreground="{DynamicResource TeamOrange}"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="OrangeTeamPause" Height="20" FontSize="10.5" Visibility="Collapsed"
                                            Padding="7,0,7,0" Margin="0,5,4,0" Click="OrangeTeamPauseClick"
                                            Background="{DynamicResource TeamOrangeEdge}"
                                            BorderBrush="{DynamicResource TeamOrangeEdge}">Pause</Button>
                                    <Button x:Name="OrangeTeamReadyUp" Height="20" FontSize="10.5" Visibility="Collapsed"
                                            Padding="7,0,7,0" Margin="0,5,4,0" Click="OrangeTeamReadyClick"
                                            Background="{DynamicResource TeamOrangeEdge}"
                                            BorderBrush="{DynamicResource TeamOrangeEdge}">Ready</Button>
                                    <Button x:Name="OrangeTeamRestart" Height="20" FontSize="10.5" Visibility="Collapsed"
                                            Padding="7,0,7,0" Margin="0,5,0,0" Click="OrangeTeamRestartClick"
                                            Background="{DynamicResource TeamOrangeEdge}"
                                            BorderBrush="{DynamicResource TeamOrangeEdge}">Restart</Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="OrangeTeamPlayersBox" Background="{DynamicResource SurfaceCard}">
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- spectators -->
                <Border x:Name="spectatorsBox" Grid.Row="3" Margin="0,10,0,0" CornerRadius="6" ClipToBounds="True"
                        BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1">
                    <StackPanel>
                        <Border Background="{DynamicResource SurfaceRaised}" Padding="10,7,10,7"
                                BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="0,0,0,1">
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Width="3" Height="12" RadiusX="2" RadiusY="2"
                                           Fill="{DynamicResource TextFaint}" VerticalAlignment="Center"/>
                                <Label Content="{x:Static p:Resources.Spectators}" FontSize="9.5" FontWeight="SemiBold"
                                       Padding="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFaint}"/>
                            </StackPanel>
                        </Border>
                        <StackPanel Background="{DynamicResource SurfaceCard}">
                            <StackPanel x:Name="SpectatorsPlayersBox"/>
                            <TextBlock x:Name="NoSpectatorsLabel" Text="No spectators" FontSize="11.5"
                                       Margin="10,9,10,9" Foreground="{DynamicResource TextFaint}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Fills whatever's left above the overlay button and scales with it: the Star row
                     shrinks as the window shrinks, and Stretch=Uniform keeps the image's own aspect
                     ratio as it does. HighQuality scaling avoids the blocky look a 2500px source gets
                     from the default bilinear downscale at small sizes. -->
                <Image Grid.Row="4" Source="/img/alternate_white.png" Stretch="Uniform"
                       Margin="0,14,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
            </DockPanel>
        </Border>

        <Grid x:Name="Center_Panel" Grid.Row="1" Grid.Column="2">
            <!-- Background/BorderBrush/Padding override the theme's TabControl default (a background
                 fill, a 1px border, and 2px padding around the content), which the ScrollingTabs
                 template applies to the whole content area via TemplateBinding. Left in place, the
                 2px padding alone still left a thin seam of the window's background showing around
                 the dashboard's edges even with the border and fill removed. Content fills edge-to-
                 edge now. -->
            <TabControl x:Name="tabControl" SelectedIndex="0" Margin="0,4,0,0"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        Template="{StaticResource ScrollingTabs}">
                <TabControl.Resources>
                    <!-- Scoped to this TabControl only (there's exactly one in this window) — an
                         implicit TargetType="TabItem" style here can't reach any other TabControl. -->
                    <Style TargetType="{x:Type TabItem}">
                        <Setter Property="Padding" Value="10,0,10,0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="{x:Type TabItem}">
                                    <Border x:Name="border" CornerRadius="6" Margin="0,3,2,3"
                                            Padding="{TemplateBinding Padding}" Background="Transparent">
                                        <ContentPresenter ContentSource="Header" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" RecognizesAccessKey="False"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource ControlMouseOverBackground}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceRaised}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TabControl.Resources>
                <TabItem x:Name="DashboardTab" FontSize="12.5" Padding="7,0,7,0" Margin="4,-2,-2,0" Visibility="{l:SettingBinding showDashboardTab, Converter={StaticResource BoolToVis}}">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="/img/view-dashboard.png" Height="14" VerticalAlignment="Center"/>
                            <Label Content="{x:Static p:Resources.Dashboard}" Padding="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource TabHeaderLabel}"/>
                        </StackPanel>
                    </TabItem.Header>
                    <Grid>
                        <!-- The dashboard renders the design's own markup (resources/dashboard.html).
                             ArenaDashboardGrid below is the native fallback, shown only if WebView2
                             fails to start. -->
                        <wv2:WebView2 x:Name="DashboardWebView" Visibility="Collapsed"
                                      DefaultBackgroundColor="Transparent"/>

                        <Grid x:Name="ArenaDashboardGrid" Background="{DynamicResource SurfaceGround}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="5*"/>
                                <RowDefinition Height="3*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="6*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ── Last throw / player speeds ── -->
                            <Border x:Name="playerSpeedsGroupbox" Grid.Row="0" Grid.Column="0" Margin="8,8,4,4"
                                    CornerRadius="6" Padding="12,10,12,12" Background="{DynamicResource SurfaceCard}"
                                    BorderThickness="0">
                                <StackPanel>
                                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                                        <ComboBox DockPanel.Dock="Left" Height="22" FontSize="11" MinWidth="120"
                                                  SelectedIndex="{l:SettingBinding dashboardItem1}" SelectionChanged="DashboardItem1Changed">
                                            <ComboBoxItem Content="{x:Static p:Resources.Last_Throw}"/>
                                            <ComboBoxItem Content="{x:Static p:Resources.Player_Speeds}" />
                                        </ComboBox>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                            <TextBlock x:Name="ThrowTotalValue" Text="--" FontSize="22" FontWeight="Bold"
                                                       FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="m/s" FontSize="10.5" Margin="4,0,0,3" VerticalAlignment="Bottom"
                                                       Foreground="{DynamicResource TextFaint}"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- player speeds view -->
                                    <StackPanel x:Name="playerSpeedsBox" Visibility="Collapsed"/>

                                    <!-- last throw view -->
                                    <StackPanel x:Name="lastThrowStats">
                                        <Grid x:Name="ThrowCompositionBar" Height="7" Margin="0,0,0,6" Visibility="Hidden">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="ThrowArmShare" Width="1*"/>
                                                <ColumnDefinition x:Name="ThrowWristShare" Width="1*"/>
                                                <ColumnDefinition x:Name="ThrowMoveShare" Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Margin="0,0,1.5,0" CornerRadius="3,0,0,3" Background="{DynamicResource TeamBlue}"/>
                                            <Border Grid.Column="1" Margin="0,0,1.5,0" Background="{DynamicResource StatusWarn}"/>
                                            <Border Grid.Column="2" CornerRadius="0,3,3,0" Background="{DynamicResource StatusGood}"/>
                                        </Grid>

                                        <UniformGrid Columns="3" Margin="0,0,0,10">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="{DynamicResource TeamBlue}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Arm" FontSize="10.5" Margin="5,0,5,0" Foreground="{DynamicResource TextDim}"/>
                                                <TextBlock x:Name="ThrowArmValue" Text="--" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="{DynamicResource StatusWarn}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Wrist" FontSize="10.5" Margin="5,0,5,0" Foreground="{DynamicResource TextDim}"/>
                                                <TextBlock x:Name="ThrowWristValue" Text="--" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Width="6" Height="6" RadiusX="1" RadiusY="1" Fill="{DynamicResource StatusGood}" VerticalAlignment="Center"/>
                                                <TextBlock Text="Move" FontSize="10.5" Margin="5,0,5,0" Foreground="{DynamicResource TextDim}"/>
                                                <TextBlock x:Name="ThrowMoveValue" Text="--" FontSize="10.5" FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                        </UniformGrid>

                                        <Border Height="1" Background="{DynamicResource SurfaceBorderSoft}" Margin="0,0,0,10"/>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="TOUCH" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource TextFaint}"/>
                                                <DockPanel Margin="0,0,0,4"><TextBlock Text="Arm speed" FontSize="11.5" Foreground="{DynamicResource TextDim}"/><TextBlock x:Name="ThrowArmSpeedValue" Text="--" FontSize="11.5" FontFamily="Consolas" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}"/></DockPanel>
                                                <DockPanel Margin="0,0,0,4"><TextBlock Text="Rots/sec" FontSize="11.5" Foreground="{DynamicResource TextDim}"/><TextBlock x:Name="ThrowRotsValue" Text="--" FontSize="11.5" FontFamily="Consolas" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}"/></DockPanel>
                                                <DockPanel><TextBlock Text="Pot. speed" FontSize="11.5" Foreground="{DynamicResource TextDim}"/><TextBlock x:Name="ThrowPotSpeedValue" Text="--" FontSize="11.5" FontFamily="Consolas" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}"/></DockPanel>
                                            </StackPanel>
                                            <Border Grid.Column="1" Width="1" HorizontalAlignment="Center" Background="{DynamicResource SurfaceBorderSoft}"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="ALIGNMENT" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,5" Foreground="{DynamicResource TextFaint}"/>
                                                <DockPanel Margin="0,0,0,4"><TextBlock Text="Off-axis" FontSize="11.5" Foreground="{DynamicResource TextDim}"/><TextBlock x:Name="ThrowOffAxisValue" Text="--" FontSize="11.5" FontFamily="Consolas" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}"/></DockPanel>
                                                <DockPanel Margin="0,0,0,4"><TextBlock Text="Wrist align" FontSize="11.5" Foreground="{DynamicResource TextDim}"/><TextBlock x:Name="ThrowWristAlignValue" Text="--" FontSize="11.5" FontFamily="Consolas" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}"/></DockPanel>
                                                <DockPanel><TextBlock Text="Move align" FontSize="11.5" Foreground="{DynamicResource TextDim}"/><TextBlock x:Name="ThrowMoveAlignValue" Text="--" FontSize="11.5" FontFamily="Consolas" HorizontalAlignment="Right" Foreground="{DynamicResource TextPrimary}"/></DockPanel>
                                            </StackPanel>
                                        </Grid>

                                        <Border BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,10,0,0"
                                                BorderBrush="{DynamicResource SurfaceBorderSoft}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="THROW QUALITY" FontSize="9" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource TextFaint}"/>
                                                <TextBlock x:Name="ThrowQualityValue" DockPanel.Dock="Right" Text="--" FontSize="11"
                                                           FontFamily="Consolas" Width="26" TextAlignment="Right"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource TextDim}"/>
                                                <Grid Height="4" Margin="10,0,8,0" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition x:Name="ThrowQualityFilled" Width="0.001*"/>
                                                        <ColumnDefinition x:Name="ThrowQualityRest" Width="1*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{DynamicResource SurfaceTrack}"/>
                                                    <Border x:Name="ThrowQualityFill" Grid.Column="0" CornerRadius="2" Background="{DynamicResource StatusGood}"/>
                                                </Grid>
                                            </DockPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ── Disc speed + joust times ── -->
                            <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="4,8,4,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border x:Name="discSpeedsGroupbox" Grid.Row="0" CornerRadius="6" Padding="12,10,12,12"
                                        Background="{DynamicResource SurfaceCard}"
                                        BorderThickness="0">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static p:Resources.Disc_Speed}" FontSize="9.5" FontWeight="SemiBold"
                                                   Margin="0,0,0,4" Foreground="{DynamicResource TextFaint}"/>
                                        <TextBlock x:Name="discSpeedLabel" Text="0" FontSize="30" FontWeight="Bold"
                                                   FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}"/>
                                        <Polyline x:Name="DiscSpeedSparkline" Height="30" Margin="0,8,0,0" StrokeThickness="1.5"
                                                  StrokeLineJoin="Round" Stretch="None"
                                                  Stroke="{DynamicResource ControlAccent}"/>
                                        <DockPanel Margin="0,3,0,0" LastChildFill="False">
                                            <TextBlock DockPanel.Dock="Left" Text="Last 60 s" FontSize="10"
                                                       Foreground="{DynamicResource TextFaint}"/>
                                            <TextBlock x:Name="DiscSpeedPeak" DockPanel.Dock="Right" Text="peak --" FontSize="10"
                                                       FontFamily="Consolas" Foreground="{DynamicResource TextDim}"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="lastJoustsBox" Grid.Row="1" Margin="0,8,0,0" CornerRadius="6" Padding="12,10,12,12"
                                        Background="{DynamicResource SurfaceCard}"
                                        BorderThickness="0">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                                            <TextBlock DockPanel.Dock="Left" Text="{x:Static p:Resources.Joust_Times}" FontSize="9.5"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFaint}"/>
                                            <TextBlock x:Name="JoustAverageLabel" DockPanel.Dock="Left" Text="" FontSize="10.5"
                                                       FontFamily="Consolas" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextDim}"/>
                                            <Button DockPanel.Dock="Right" Click="OpenLocalDatabaseBrowser" Height="22" Width="26" Padding="0"
                                                    Background="{DynamicResource ControlDefaultBackground}"
                                                    Foreground="{DynamicResource ControlPrimaryForeground}"
                                                    BorderBrush="{DynamicResource SurfaceBorder}">
                                                <Image Source="/img/open-in-new.png" Height="13"/>
                                            </Button>
                                            <ComboBox DockPanel.Dock="Right" Height="22" FontSize="11" Margin="0,0,5,0" MinWidth="84"
                                                      SelectedIndex="{l:SettingBinding dashboardJoustTimeOrder}"
                                                      ToolTip="{x:Static p:Resources.Only_stores_up_to_the_100_most_recent_joust_times_}">
                                                <ComboBoxItem Content="{x:Static p:Resources.Recent}"/>
                                                <ComboBoxItem Content="{x:Static p:Resources.Fastest}"/>
                                            </ComboBox>
                                        </DockPanel>
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <StackPanel x:Name="JoustTimesBox"/>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Grid>

                            <!-- ── Player pings ── -->
                            <Border x:Name="playerPingsGroupbox" Grid.Row="0" Grid.Column="3" Margin="4,8,8,4"
                                    CornerRadius="6" Padding="12,10,12,12" Background="{DynamicResource SurfaceCard}"
                                    BorderThickness="0">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,10">
                                        <TextBlock DockPanel.Dock="Left" Text="NETWORK" FontSize="9.5"
                                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFaint}"/>
                                        <Border x:Name="ServerScoreChip" DockPanel.Dock="Right" Height="20" CornerRadius="10"
                                                Padding="8,0,8,0" Background="{DynamicResource SurfaceRaised}"
                                                BorderThickness="0">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="ServerScoreDot" Width="5" Height="5" VerticalAlignment="Center"
                                                         Fill="{DynamicResource TextFaint}"/>
                                                <TextBlock x:Name="ServerScoreLabel" Text="--" FontSize="10.5" Margin="6,0,0,0"
                                                           VerticalAlignment="Center" Foreground="{DynamicResource TextDim}"/>
                                            </StackPanel>
                                        </Border>
                                    </DockPanel>

                                    <!-- headline network figures -->
                                    <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,11">
                                        <Border Margin="0,0,4,0" CornerRadius="5" Padding="9,6,9,7"
                                                Background="{DynamicResource SurfaceRaised}"
                                                BorderThickness="0">
                                            <StackPanel>
                                                <TextBlock Text="AVG PING" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock x:Name="AvgPingValue" Text="--" FontSize="17" FontWeight="SemiBold"
                                                               FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}"/>
                                                    <TextBlock Text="ms" FontSize="10" Margin="3,0,0,2" VerticalAlignment="Bottom"
                                                               Foreground="{DynamicResource TextFaint}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="2,0,2,0" CornerRadius="5" Padding="9,6,9,7"
                                                Background="{DynamicResource SurfaceRaised}"
                                                BorderThickness="0">
                                            <StackPanel>
                                                <TextBlock Text="LOSS" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock x:Name="PacketLossValue" Text="--" FontSize="17" FontWeight="SemiBold"
                                                               FontFamily="Consolas" Foreground="{DynamicResource StatusGood}"/>
                                                    <TextBlock Text="%" FontSize="10" Margin="3,0,0,2" VerticalAlignment="Bottom"
                                                               Foreground="{DynamicResource TextFaint}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="4,0,0,0" CornerRadius="5" Padding="9,6,9,7"
                                                Background="{DynamicResource SurfaceRaised}"
                                                BorderThickness="0">
                                            <StackPanel>
                                                <!-- Bound to WorstPingValue: the API exposes no tickrate, so labelling it one
                                                     would print a ping under a name that isn't what it measures. -->
                                                <TextBlock Text="WORST" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock x:Name="WorstPingValue" Text="--" FontSize="17" FontWeight="SemiBold"
                                                               FontFamily="Consolas" Foreground="{DynamicResource TextPrimary}"/>
                                                    <TextBlock Text="ms" FontSize="10" Margin="3,0,0,2" VerticalAlignment="Bottom"
                                                               Foreground="{DynamicResource TextFaint}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <!-- server score -->
                                    <Border DockPanel.Dock="Bottom" BorderThickness="0,1,0,0" Padding="0,9,0,0" Margin="0,9,0,0"
                                            BorderBrush="{DynamicResource SurfaceBorderSoft}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="SERVER SCORE" FontSize="9" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextFaint}"/>
                                            <TextBlock x:Name="ServerScoreNumber" DockPanel.Dock="Right" Text="--" FontSize="11"
                                                       FontFamily="Consolas" Width="30" TextAlignment="Right"
                                                       VerticalAlignment="Center" Foreground="{DynamicResource TextDim}"/>
                                            <Grid Height="4" Margin="10,0,8,0" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition x:Name="ServerScoreFilled" Width="0.001*"/>
                                                    <ColumnDefinition x:Name="ServerScoreRest" Width="1*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{DynamicResource SurfaceTrack}"/>
                                                <Border Grid.Column="0" CornerRadius="2" Background="{DynamicResource ControlAccent}"/>
                                            </Grid>
                                        </DockPanel>
                                    </Border>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="PlayerPingsBox"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <!-- ── Previous rounds ── -->
                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="8,4,4,8"
                                    CornerRadius="6" Padding="12,10,12,12" Background="{DynamicResource SurfaceCard}"
                                    BorderThickness="0">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="{x:Static p:Resources.Previous_Rounds}" FontSize="9.5"
                                               FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource TextFaint}"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="LastRoundScoresBox"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>

                            <!-- ── Previous goals ── -->
                            <Border Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Margin="4,4,8,8"
                                    CornerRadius="6" Padding="12,10,12,12" Background="{DynamicResource SurfaceCard}"
                                    BorderThickness="0">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Left" Text="{x:Static p:Resources.Previous_Goals}" FontSize="9.5"
                                                   FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                                        <TextBlock x:Name="BestGoalSpeedLabel" DockPanel.Dock="Right" Text="" FontSize="10.5"
                                                   FontFamily="Consolas" Foreground="{DynamicResource TextFaint}"/>
                                    </DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="8,0,8,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="52"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="TIME" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                                        <TextBlock Grid.Column="1" Text="PTS" FontSize="8.5" FontWeight="SemiBold" TextAlignment="Right" Foreground="{DynamicResource TextFaint}"/>
                                        <TextBlock Grid.Column="2" Text="SCORER" FontSize="8.5" FontWeight="SemiBold" Margin="10,0,0,0" Foreground="{DynamicResource TextFaint}"/>
                                        <TextBlock Grid.Column="3" Text="SPEED" FontSize="8.5" FontWeight="SemiBold" TextAlignment="Right" Foreground="{DynamicResource TextFaint}"/>
                                        <TextBlock Grid.Column="4" Text="DIST" FontSize="8.5" FontWeight="SemiBold" TextAlignment="Right" Foreground="{DynamicResource TextFaint}"/>
                                    </Grid>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="LastGoalsBox"/>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Grid>

                        <Grid x:Name="CombatDashboardGrid" Background="{DynamicResource SurfaceGround}" Visibility="Collapsed" Margin="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="292" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- ROW 1: Match | Kill Feed | Network -->
                            <Grid Grid.Row="0" Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="340"/>
                                    <ColumnDefinition Width="216"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- MATCH card -->
                                <Border Grid.Column="0" Margin="0,0,12,0" Background="{DynamicResource SurfaceCard}" BorderBrush="{DynamicResource SurfaceBorder}" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="MATCH" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Left"/>
                                            <TextBlock x:Name="CombatMapLabel" Text="--" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextDim}" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="92"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom">
                                                <TextBlock Text="BLUE" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TeamBlue}"/>
                                                <TextBlock x:Name="CombatBlueScore" Text="0" FontFamily="Consolas" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TeamBlue}" Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                                                <TextBlock x:Name="CombatClockText" Text="--:--" FontFamily="Consolas" FontSize="16" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="CombatRoundText" Text="No round" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                <TextBlock Text="ORANGE" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource TeamOrange}" HorizontalAlignment="Right"/>
                                                <TextBlock x:Name="CombatOrangeScore" Text="0" FontFamily="Consolas" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TeamOrange}" Margin="0,3,0,0" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Height="1" Background="{DynamicResource SurfaceBorderSoft}" Margin="0,12,0,12"/>

                                        <!-- Capture point objective -->
                                        <StackPanel x:Name="CombatCaptureObjectivePanel">
                                            <Grid>
                                                <TextBlock Text="CAPTURE POINT" FontSize="9.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}"/>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Ellipse x:Name="CombatCaptureStateDot" Width="5" Height="5" Fill="{DynamicResource TextFaint}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock x:Name="CombatCaptureStateText" Text="--" FontSize="10" Foreground="{DynamicResource TextFaint}"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Height="11" Margin="0,9,0,0" VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition x:Name="CombatBlueCaptureRest" Width="1*"/>
                                                        <ColumnDefinition x:Name="CombatBlueCaptureFill" Width="0.001*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.ColumnSpan="2" Height="7" CornerRadius="3,0,0,3" Background="{DynamicResource SurfaceTrack}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1" Height="7" CornerRadius="3,0,0,3" Background="{DynamicResource TeamBlue}" VerticalAlignment="Center"/>
                                                </Grid>
                                                <Border Grid.Column="1" Width="1" Height="11" Background="{DynamicResource TextFaint}"/>
                                                <Grid Grid.Column="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition x:Name="CombatOrangeCaptureFill" Width="0.001*"/>
                                                        <ColumnDefinition x:Name="CombatOrangeCaptureRest" Width="1*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.ColumnSpan="2" Height="7" CornerRadius="0,3,3,0" Background="{DynamicResource SurfaceTrack}" VerticalAlignment="Center"/>
                                                    <Border Grid.Column="0" Height="7" CornerRadius="0,3,3,0" Background="{DynamicResource TeamOrange}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Grid>
                                            <Grid Margin="0,6,0,0">
                                                <TextBlock x:Name="CombatBluePctText" Text="--" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TeamBlue}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="HOLD" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFaint}" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="CombatOrangePctText" Text="--" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource TeamOrange}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>

                                        <!-- Payload objective -->
                                        <StackPanel x:Name="CombatPayloadObjectivePanel" Visibility="Collapsed">
                                            <Grid>
